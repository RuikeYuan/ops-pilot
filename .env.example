# Compose reads .env; the Python application reads shell environment variables.
OPS_TOKEN=replace-with-at-least-24-random-characters
POSTGRES_PASSWORD=replaceWithRandomLettersAndDigits
OPS_DEMO=false
OPS_WORKSPACE=My studio
# Optional direct run settings:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/opspilot?sslmode=require
# OPS_SECURE_COOKIE=true
# OPS_REGION=westeurope
# Optional legacy administrator credentials; public account registration is also enabled.
# OPS_ADMIN_EMAIL=owner@example.com
# OPS_ADMIN_PASSWORD=use-a-long-random-password
# OPS_SESSION_SECRET=use-a-separate-long-random-secret
# Optional Google sign-in. In Google OAuth Testing mode, add allowed people as test users in Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-host.example/api/auth/google/callback
